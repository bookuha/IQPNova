pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        timestamps()
        disableConcurrentBuilds()
    }
    stages {
        stage("Create Docker Image") {
            steps {
                echo "=== Creating Docker Image ==="
                dir ('src/IQP.Web') {
                    sh 'docker build .'
                }
            }
        }
    }
}
